FROM node:24-bookworm-slim AS dependencies
WORKDIR /workspace
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY admin/package.json admin/package.json
RUN npm install --global "$(node -p "require('./package.json').packageManager")"
RUN pnpm --filter @happy-pet/admin... install --frozen-lockfile
FROM dependencies AS build
COPY SKILL.md ./SKILL.md
COPY admin/ admin/
RUN pnpm --filter @happy-pet/admin build
FROM nginx:stable-alpine
RUN sed -i '/^user /d;s@^pid[[:space:]].*;@pid /tmp/nginx.pid;@' /etc/nginx/nginx.conf && chown -R nginx:nginx /var/cache/nginx
COPY --from=build /workspace/admin/dist/ /usr/share/nginx/html/admin/
COPY admin/nginx.conf /etc/nginx/conf.d/default.conf
USER nginx
RUN nginx -t
EXPOSE 8080
HEALTHCHECK --interval=10s --timeout=5s --start-period=10s --retries=6 CMD wget -q -O /dev/null http://127.0.0.1:8080/healthz
ENTRYPOINT ["nginx"]
CMD ["-g", "daemon off;"]
