# Public image coordinates; override IMAGE_PREFIX for your own registry/namespace.
IMAGE_PREFIX=crpi-ckmtqd558kzqdlu7.cn-hangzhou.personal.cr.aliyuncs.com/happy-pet
IMAGE_TAG=latest
PGUSER=happy_pet
PGDATABASE=happy_pet
# Independent production credentials. Never reuse backend/.env.local.
POSTGRES_PASSWORD=
JWT_SECRET=
# Used only when the database is first initialized; existing passwords are preserved.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# HTTPS origin only, without /admin/ or /api/v1.
ADMIN_ORIGIN=
WECHAT_APP_ID=wx5f84ab7af535815d
WECHAT_APP_SECRET=
# The gateway is bound to loopback. Terminate TLS in the host Nginx/Baota site.
GATEWAY_PORT=8080
