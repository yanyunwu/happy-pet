{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "endOfLine": "lf",
  "sortPackageJson": false,
  "ignorePatterns": [
    ".agents/**",
    ".claude/**",
    ".vscode/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/.swc/**",
    "**/.build/**",
    "**/build/**",
    "**/library/**",
    "**/temp/**",
    "**/profiles/**",
    "**/local/**",
    "**/output/**",
    "artifacts/**",
    "backups/**",
    "minigame/art/**",
    "minigame/settings/**",
    "minigame/build-config/**",
    "**/*.meta",
    "**/*.scene",
    "backend/internal/dbgen/**",
    "backend/data/**",
    "pnpm-lock.yaml",
    "**/*.log"
  ]
}
